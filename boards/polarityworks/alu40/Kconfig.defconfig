config ZMK_KEYBOARD_NAME
    default "ALU40" if BOARD_ALU40

if BOARD_ALU40

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif # USB

config BT_CTLR
    default BT

endif # BOARD_ALU40
